            case 'y':
            case 'Y':
                *LIFE=3;
                lvl_1(LIFE);
                break; 
            case 'n':
            case 'N':
                exit(0);
            default:
                printf("Scelta non valida. Riprova.\n");
                break;
        }        
    }
}
