void setColor(int textColor, int bgColor) {
    HANDLE hConsole = GetStdHandle(STD_OUTPUT_HANDLE);
    SetConsoleTextAttribute(hConsole, (bgColor << 4) | textColor);
}

void file(int *cake){
    (*cake)++;
    FILE *fp=fopen("salva.txt","w");
    if(fp==NULL){
        printf("ERROR");
        exit(1);
    }else{
        fprintf(fp, "%d", *cake);
    }
    fclose(fp);
}
void rea(int *cake){
    FILE *fp=fopen("salva.txt","r");
    if(fp==NULL){
        file(cake);
    }else{
        fscanf(fp, "%d", cake);
    }
    fclose(fp);
}
